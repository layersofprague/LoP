  "curator.stare-mesto.title": {
    "cs": "Měšťák a Hausknecht",
    "en": "Burgher and Hausknecht"
  },
  "curator.stare-mesto.desc": {
    "cs": "Měšťákům a Hausnknechtům se říkalo bohatým obchodníkům, ale také rázovitým rváčům a kočím z přístavních krčem.",
    "en": "Burghers and Hausknechts meant both the wealthy merchants and the rough-and-ready brawlers and coachmen from the harbour taverns."
  },
  "curator.nove-mesto.title": {
    "cs": "Rachunbář a Františkán",
    "en": "Rachunbář and Franciscan"
  },
  "curator.nove-mesto.desc": {
    "cs": "Rachunbářům a Františkánům se říkalo chudším dělníkům, kteří pili v hospodách na dluh, a mnichům z místních klášterů.",
    "en": "“Rachunbáři” and Franciscans were the poorer labourers who drank on credit in the pubs, and the monks from the local monasteries."
  },
  "curator.mala-strana.title": {
    "cs": "Malostranský Špunt a Lokaj"
  },
  "curator.mala-strana.desc": {
    "cs": "Malostranským Špuntům a Lokajům se říkalo klukům z bojovných part na zamrzlé Vltavě a služebnictvu ze šlechtických paláců."
  },
  "curator.hradcany.title": {
    "cs": "Kastelán a Kapucín",
    "en": "Castellan and Capuchin"
  },
  "curator.hradcany.desc": {
    "cs": "Kastelánům a Kapucínům se říkalo chudině a řemeslníkům navázaným na Pražský hrad a klášterní život v okolí Lorety.",
    "en": "Castellans and Capuchins were the poor and the craftsmen tied to Prague Castle, and the monks of the monastic life around Loreta."
  },
  "curator.josefov.title": {
    "cs": "Meiselovec"
  },
  "curator.josefov.desc": {
    "cs": "Meiselovecem se říkalo obyvateli židovského ghetta, pojmenovaným po nejslavnějším historickém starostovi Mordechaji Maiselovi."
  },
  "curator.zizkov.title": {
    "cs": "Žižkovský Pepík"
  },
  "curator.zizkov.desc": {
    "cs": "Žižkovskými Pepíky se říkalo slavným pouličním frajerkům, dělníkům a bohémům s typickým stylem oblékání a vlastním slangem."
  },
  "curator.smichov.title": {
    "cs": "Smíchovský Baraba"
  },
  "curator.smichov.desc": {
    "cs": "Smíchovskými Barabami se říkalo drsným, hlučným a tvrdě pracujícím dělníkům z místních obřích továren a pivovaru."
  },
  "curator.holesovice.title": {
    "cs": "Holešovický Šupák",
    "en": "Holešovice “Šupák”"
  },
  "curator.holesovice.desc": {
    "cs": "Holešovickými Šupáky se říkalo přístavním dělníkům, kteří šupovali – tedy posouvali a vykládali sudy a bedny z lodí.",
    "en": "“Šupáci” were the port workers of Holešovice — the name comes from šupovat, to shove: shifting and unloading barrels and crates from the boats."
  },
  "curator.karlin.title": {
    "cs": "Karlínský kluk"
  },
  "curator.karlin.desc": {
    "cs": "Karlínskými kluky se říkalo drsnějším dělnickým partám z první pravé průmyslové čtvrti Prahy."
  },
  "curator.kosire.title": {
    "cs": "Košířský rváč"
  },
  "curator.kosire.desc": {
    "cs": "Košířskými rváči se říkalo divokým partám z tehdejší periferie, které neustále bojovaly se sousedním Smíchovem."
  },
  "curator.podskali.title": {
    "cs": "Podskalák a Plavec"
  },
  "curator.podskali.desc": {
    "cs": "Podskalákům a Plavcům se říkalo hrdé a uzavřené komunitě vorařů, ledařů a rybářů z oblasti dnešní Výtoně."
  },
  "curator.kampa.title": {
    "cs": "Kampán"
  },
  "curator.kampa.desc": {
    "cs": "Kampány se říkalo obyvatelům polovenkovské izolované komunity pradlen, mlynářů a rybářů z vltavského ostrova."
  },
  "curator.branik.title": {
    "cs": "Branský ledař"
  },
  "curator.branik.desc": {
    "cs": "Branskými ledaři se říkalo dělníkům, kteří v zimě sekali na zamrzlé Vltavě led a sváželi ho do branických ledáren."
  },
  "curator.podoli.title": {
    "cs": "Podolský cementárník"
  },
  "curator.podoli.desc": {
    "cs": "Podolskými cementárníky se říkalo dělníkům z bývalé slavné podolské cementárny, kteří tvořili jádro tamní říční komunity."
  },
  "curator.nusle.title": {
    "cs": "Nuselský Kafemlejnek"
  },
  "curator.nusle.desc": {
    "cs": "Nuselskými Kafemlejnky se říkalo chudšímu pavlačovému obyvatelstvu, jehož sousedky neustále melely pantem a ráno mlely meltu."
  },
  "curator.liben.title": {
    "cs": "Libeňský Balonář"
  },
  "curator.liben.desc": {
    "cs": "Libeňskými Balonáři se říkalo klukům, kteří fascinovaně sledovali vypouštění prvních pražských balonů v Libeni."
  },
  "curator.vysehrad.title": {
    "cs": "Vyšehradský Kanovník a Peckář"
  },
  "curator.vysehrad.desc": {
    "cs": "Vyšehradskými Kanovníky a Peckáři se říkalo kněžím z kapituly a pěstitelům třešní a švestek, které prodávali po celé Praze."
  },
  "curator.vrsovice.title": {
    "cs": "Vršovický Koloběžkář"
  },
  "curator.vrsovice.desc": {
    "cs": "Vršovickými Koloběžkáři se ironicky říkalo obyvatelům venkovského předměstí bez pořádné dopravy, kde se lidé museli neustále přesouvat."
  },
  "curator.vinohrady.title": {
    "cs": "Vinohradský paňáca"
  },
  "curator.vinohrady.desc": {
    "cs": "Vinohradskými paňácy se posměšně říkalo bohatším a elegantním měšťanům – a to zejména v ústech jejich žižkovských sousedů."
  },
  "curator.brevnov.title": {
    "cs": "Břevnovský zelinář a Benediktin"
  },
  "curator.brevnov.desc": {
    "cs": "Břevnovskými zelináři a Benediktiny se říkalo pěstitelům a mnichům spjatým se zahradami, které historicky patřily Břevnovskému klášteru."
  },
  "curator.troja.title": {
    "cs": "Trojský vinař"
  },
  "curator.troja.desc": {
    "cs": "Trojskými vinaři se říkalo obyvatelům svahů nad Vltavou, kteří po staletí udržovali tradici pěstování vinné révy."
  },
  "curator.letna.title": {
    "cs": "Sparťan"
  },
  "curator.letna.desc": {
    "cs": "Sparťany se říkalo obyvatelům Letné – podle zdejšího fotbalového klubu AC Sparta Praha."
  },
  "report.link": {
